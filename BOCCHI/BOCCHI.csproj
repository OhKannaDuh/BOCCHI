<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Dalamud.NET.Sdk/15.0.0">
    <PropertyGroup>
        <AssemblyName>BOCCHI</AssemblyName>
        <Version>4.2.0.11</Version>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
        <DefineConstants>DEBUG;TRACE;</DefineConstants>
    </PropertyGroup>

    <!-- Translations -->
    <ItemGroup>
        <None Include="..\Ocelot\Translations\**">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
            <Link>Translations\%(RecursiveDir)ocelot.%(Filename)%(Extension)</Link>
        </None>
        <None Include="..\Translations\**">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
            <Link>Translations\%(RecursiveDir)%(Filename)%(Extension)</Link>
        </None>
        <None Include="Sounds\**\*">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
        <EmbeddedResource Include="..\CHANGELOG.md">
            <LogicalName>BOCCHI.CHANGELOG.md</LogicalName>
        </EmbeddedResource>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../BOCCHI.Common/BOCCHI.Common.csproj"/>
        <ProjectReference Include="../BOCCHI.Automator/BOCCHI.Automator.csproj"/>

        <ProjectReference Include="../BOCCHI.Trackers/BOCCHI.Trackers.csproj"/>
        <ProjectReference Include="../BOCCHI.World/BOCCHI.World.csproj"/>
        <ProjectReference Include="../BOCCHI.Buff/BOCCHI.Buff.csproj"/>
        <ProjectReference Include="../BOCCHI.MobFarmer/BOCCHI.MobFarmer.csproj"/>
        <ProjectReference Include="../BOCCHI.Treasure/BOCCHI.Treasure.csproj"/>
        <ProjectReference Include="../BOCCHI.Debug/BOCCHI.Debug.csproj"/>
        <ProjectReference Include="../Ocelot/Ocelot.Rotation/Ocelot.Rotation.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="ClientStructsExposed.UnknownFieldGenerator" Version="0.1.3"/>
    </ItemGroup>
</Project>