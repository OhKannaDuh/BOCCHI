{
  "name": "bocchi-coffer-api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "types": "wrangler types",
    "check": "wrangler types && tsc --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply bocchi-coffer-observations --local",
    "db:migrate:remote": "wrangler d1 migrations apply bocchi-coffer-observations --remote"
  },
  "devDependencies": {
    "typescript": "^5.8.3",
    "wrangler": "^4.149.0"
  }
}
